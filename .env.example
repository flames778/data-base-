# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Database ----------------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime.
# For Supabase: Project Settings -> Database -> Connection string ->
# use the "Transaction" pooler URI (port 6543) for serverless/Vercel, e.g.:
# postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://precpearl:precpearl_dev@localhost:5433/precpearl"

# REQUIRED. Direct (non-pooled) connection string, used only for running
# migrations (`prisma migrate deploy`/`dev`) — PgBouncer's transaction pooler
# doesn't support the session-mode features migrations need.
# - Local Postgres / docker-compose (no pooler): set this to the SAME value
#   as DATABASE_URL.
# - Supabase: use the direct connection string (port 5432), e.g.:
#   postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://precpearl:precpearl_dev@localhost:5433/precpearl"

# ---- Auth.js / NextAuth -------------------------------------------------
# Secret used to sign/encrypt JWTs and cookies. Generate a strong random
# value for every environment, e.g.: `openssl rand -base64 32`
# NEVER reuse a dev secret in production.
AUTH_SECRET="replace-with-a-long-random-secret"
# NEXTAUTH_SECRET is accepted as a fallback alias for AUTH_SECRET.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Public URL of the deployed app (used to build absolute links, e.g. in
# emails). Falls back to http://localhost:3000 if unset.
NEXTAUTH_URL="http://localhost:3000"
# APP_BASE_URL="http://localhost:3000"

# ---- Object storage (MinIO / S3-compatible) -----------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="precpearl"
MINIO_SECRET_KEY="precpearl-dev-secret"
MINIO_BUCKET="precpearl-private"

# ---- Error monitoring (Sentry) -------------------------------------------
# Leave unset to disable Sentry entirely (safe default for local dev).
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oXXXXXX.ingest.us.sentry.io/XXXXXXX"
# SENTRY_DSN="https://xxxx@oXXXXXX.ingest.us.sentry.io/XXXXXXX"
# Only needed if you want source maps uploaded on build (optional):
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_..."

# ---- Dev-only seed accounts ---------------------------------------------
# Set to "false" to skip creating the 4 temporary dev bootstrap accounts.
# Automatically skipped when NODE_ENV=production regardless of this value.
SEED_DEV_ACCOUNTS="true"

# Optional fixed passwords for the dev bootstrap accounts. If unset, a
# random temporary password is generated and printed once to the console,
# and the account is forced to change it at first sign-in.
# SEED_CEO_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_PROJECT_LEAD_PASSWORD=
# SEED_TEAM_MEMBER_PASSWORD=

# ---- Runtime -------------------------------------------------------------
NODE_ENV="development"

# Skip `prisma migrate deploy` in the Docker entrypoint (rarely needed).
# SKIP_MIGRATIONS="0"
